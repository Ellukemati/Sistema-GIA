#!/bin/sh

# Pre-commit hook: Formateo automático, análisis estático y testing.

echo "[INFO] 1/3 Ejecutando formateo de código (cargo fmt)..."
cargo fmt --manifest-path gia/Cargo.toml --all

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$')
if [ -n "$STAGED_FILES" ]; then
    echo "$STAGED_FILES" | xargs git add
fi

echo "[INFO] 2/3 Ejecutando análisis estático (cargo clippy)..."
if ! cargo clippy --manifest-path gia/Cargo.toml --all-targets --all-features -- -D warnings; then
    echo ""
    echo "❌ [ERROR] El análisis estático falló. Corrige los warnings de Clippy."
    echo "❌ [ERROR] El commit ha sido abortado."
    exit 1
fi

echo "[INFO] 3/3 Ejecutando tests unitarios (cargo test)..."
# Se agrego el manifest-path para evitar errores de directorio
cargo test --manifest-path gia/Cargo.toml -q

RESULT=$?

if [ $RESULT -ne 0 ]; then
    echo "❌ [ERROR] Los tests fallaron. Revisa el output de arriba."
    echo "❌ [ERROR] El commit ha sido abortado."
    exit 1
fi

echo "✅ [ÉXITO] Todo en orden: Código limpio, validado y testeado. Commit aprobado."
exit 0