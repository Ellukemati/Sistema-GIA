#!/bin/sh

# Pre-commit hook: Formateo automático y análisis estático.

echo "[INFO] Ejecutando formateo de código (cargo fmt)..."

cargo fmt --manifest-path gia/Cargo.toml --all

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$')
if [ -n "$STAGED_FILES" ]; then
    echo "$STAGED_FILES" | xargs git add
fi

echo "[INFO] Ejecutando análisis estático (cargo clippy)..."

if ! cargo clippy --manifest-path gia/Cargo.toml --all-targets --all-features -- -D warnings; then
    echo ""
    echo "[ERROR] El análisis estático falló."
    echo "[ERROR] Por favor, corregir las advertencias indicadas arriba antes de commitear."
    exit 1
fi

echo "[INFO] Validación completada con éxito. Commit aprobado."
exit 0